{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.js"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.js"
    },
    {
      "source": "/treatments",
      "destination": "/treatments.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/book",
      "destination": "/book.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ]
}
